# These are OPTIONAL — real working defaults are already baked into
# config.py, specifically because setting environment variables on
# KataBump can be a hassle. Only fill in / override these if you want
# to change something from its default. Anything you set here (or as a
# real env var on KataBump) always wins over the baked-in default.

# --- Auth ---
# REQUIRED — the app now fails to start without this (no baked-in default
# any more; the old one was exposed). Generate a real one:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Database ---
# Default is a local SQLite file — fine for KataBump (has a persistent
# disk), but WRONG for Koyeb's free tier: it has no persistent volumes, so
# this file gets wiped on every restart/redeploy, silently deleting every
# user account and quota record. On Koyeb, replace this with a free
# Supabase or Neon Postgres connection string instead, e.g.:
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./zafar.db

# --- Google Drive ---
# Paste the ENTIRE service_account.json content as this one env var's
# value (Koyeb's filesystem is ephemeral, so there's no real "upload a
# file" step — the backend reads this directly, no file involved).
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_ROOT_FOLDER_ID=

# --- Daily download limit ---
DAILY_PAPER_LIMIT=10
DAILY_BOOK_LIMIT=3

# --- Gmail SMTP (verification codes) ---
# Leave blank for local dev — the code just prints to the console instead.
# Set both on KataBump to actually send emails. SMTP_USER is a Gmail
# address; SMTP_PASS is a 16-char Gmail App Password (Google Account ->
# Security -> 2-Step Verification -> App Passwords -> Mail), NOT your
# normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Download proxy (Cloudflare Worker: cloudflare-worker/download-proxy) ---
# Base URL of the deployed download-proxy Worker, e.g.
# https://zafar-dl.<you>.workers.dev
DOWNLOAD_PROXY_BASE_URL=
# Shared secret with that Worker's DL_SECRET (wrangler secret put DL_SECRET).
# SECURITY: if either this or DOWNLOAD_PROXY_BASE_URL is left blank,
# downloads silently fall back to permanent, unsigned Drive links —
# do not deploy to production without setting both.
DOWNLOAD_SIGNING_SECRET=
DOWNLOAD_LINK_TTL_SECONDS=300

# --- Drive folder-tree cache ---
DRIVE_CACHE_TTL_SECONDS=21600
