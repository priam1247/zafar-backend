# Copy to .env for local development. Secrets must be real values; no
# production security credential has a permissive fallback.

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Database ---
# d1 requires CLOUDFLARE_ACCOUNT_ID, D1_DATABASE_ID, CLOUDFLARE_API_TOKEN.
# SQLite is convenient for local development.
DATABASE_URL=sqlite:///./zafar.db
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# --- Google services / sign-in ---
GOOGLE_SERVICE_ACCOUNT_JSON=
# OAuth Web client ID (not the client secret); leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Defaults to the established Zafar Materials (Sorted) root; override if changed.
DRIVE_ROOT_FOLDER_ID=1SWv792HexEVx7tHaSBIZvgxKwgb6-lp4

# --- Download limits (policy defaults) ---
DAILY_PAPER_LIMIT=10
DAILY_BOOK_LIMIT=3
DAILY_NOTES_LIMIT=3
DAILY_MARKING_KEYS_LIMIT=10
EMAIL_DAILY_LIMIT=500
EMAIL_DAILY_WARN_THRESHOLD=400

# Operational safeguards
API_DOCS_ENABLED=false
# Set to the exact trusted reverse-proxy IP/CIDR list for the deployment; never use '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
DRIVE_MAX_DEPTH=6

# --- Optional Drime Cloud library source ---
# API key: configure privately in Koyeb and the download-proxy Worker.
DRIME_API_KEY=
DRIME_API_URL=https://app.drime.cloud/api/v1
DRIME_ROOT_FOLDER_ID=1016158780
DRIME_WORKSPACE_ID=0
DRIME_PAPERS_FOLDER_NAMES=Mock,MANEB
DRIME_PRIMARY_FOLDER_NAMES=Primary
DRIME_BOOKS_FOLDER_NAMES=Books
DRIME_NOTES_FOLDER_NAMES=Notes
DRIME_MARKING_KEYS_FOLDER_NAMES=Marking Keys,Marking Schemes

# --- Gmail SMTP (required for registration verification) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Download proxy ---
DOWNLOAD_PROXY_BASE_URL=
DOWNLOAD_SIGNING_SECRET=
DOWNLOAD_LINK_TTL_SECONDS=300

# --- Drive cache policy ---
DRIVE_CACHE_TTL_SECONDS=21600

# Exact HTTPS frontend origin(s), comma-separated. Production uses only:
ALLOWED_ORIGINS=https://studymw.netlibrary.dpdns.org
